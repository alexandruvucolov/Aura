# ── Telegram ─────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ── OpenRouter (LLM) ────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Strong Romanian chat model (DeepSeek V4.1 Flash).
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Model for background fact extraction.
SUMMARY_MODEL=thedrummer/unslopnemo-12b

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./companion.db

# ── Persona / behaviour ─────────────────────────────────────────────────
TIMEZONE=Europe/Bucharest
# true = Aura can discuss mature/explicit topics without refusal.
ALLOW_UNFILTERED=false
CHECKIN_MIN_HOURS=18
CHECKIN_MAX_HOURS=36
CHECKIN_DAY_START=9
CHECKIN_DAY_END=22

# ── Optional Phase 4 keys ───────────────────────────────────────────────
# Voice provider: "edge" (free, native Romanian voice) or "elevenlabs".
#   Edge TTS (default) needs no key and uses a native Romanian voice.
#   ElevenLabs free plan only supports "premade" voices (international accent);
#   library voices (e.g. Romanian) require a paid plan.
TTS_PROVIDER=edge
EDGE_VOICE=ro-RO-AlinaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FAL_KEY=
